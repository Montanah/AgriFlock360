# ─────────────────────────────────────────────────────────────
# 1. General
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────
# 2. PostgreSQL (local or AWS RDS)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost               # Change to your RDS endpoint in staging/prod
DB_PORT=5432
DB_USERNAME=agriflock
DB_PASSWORD=secret123_change_me
DB_NAME=agriflock360

# ─────────────────────────────────────────────────────────────
# 3. Redis (local or AWS ElastiCache / Upstash / Redis Cloud)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Or if you use password:
# REDIS_URL=redis://:yourpassword@redis-12345.c region.redis-cloud.com:12345

# ─────────────────────────────────────────────────────────────
# 4. JWT Authentication
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_string_2025
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# 5. MQTT Broker – EMQX Cloud (or self-hosted)
# ─────────────────────────────────────────────────────────────
MQTT_URL=mqtts://your-broker.emqx.cloud:8883
MQTT_USERNAME=agriflock_backend
MQTT_PASSWORD=change_this_in_emqx_console
MQTT_CLIENT_ID=agriflock-backend-server

# Optional: clean session & keep-alive
MQTT_CLEAN_SESSION=true
MQTT_KEEP_ALIVE=60

# ─────────────────────────────────────────────────────────────
# 6. M-Pesa Daraja (Sandbox first → then Production)
# ─────────────────────────────────────────────────────────────
# Sandbox credentials (get from https://developer.safaricom.co.ke)
DARAJA_ENV=sandbox                     # sandbox | production
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_SHORTCODE=174379                # Paybill (sandbox default) or your real one
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a3cd4e0d8e5f5e8e8e8e8e8e8e8e8e8e8e8e   # Sandbox passkey
DARAJA_INITIATOR_NAME=testapi          # For B2C/C2B in production
DARAJA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/c2b/callback   # Must be public in production

# ─────────────────────────────────────────────────────────────
# 7. Airtel Money (optional – add later if needed)
# ─────────────────────────────────────────────────────────────
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=

# ─────────────────────────────────────────────────────────────
# 8. AWS (only if deploying to ECS / EC2 / Beanstalk)
# ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ─────────────────────────────────────────────────────────────
# 9. Logging & Misc
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug                        # error, warn, info, debug, verbose

# ─────────────────────────────────────────────────────────────
# 10. Frontend / Mobile URLs (for CORS & email/deep links)
# ─────────────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3001
MOBILE_APP_DEEP_LINK=agriflock://
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://staging.agriflock.co.ke

# ─────────────────────────────────────────────────────────────
# 11. PAYG Settings (business logic)
# ─────────────────────────────────────────────────────────────
PAYG_DEFAULT_DAYS_GRANTED=30           # Days granted on successful payment
PAYG_WARNING_THRESHOLD_DAYS=5          # Send warning when ≤5 days left
PAYG_GRACE_PERIOD_HOURS=24     

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=your.apple.bundle.id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback        # Extra hours after expiry before hard lock